# Copy this file to .env and fill in the values.

# Public URL of the app (no trailing slash). Instagram requires HTTPS here,
# so for local testing use a tunnel such as ngrok and put its https URL here.
APP_URL=http://localhost:3000
PORT=3000

# From developers.facebook.com → your app → Instagram → API setup with Instagram login.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Optional. Defaults to $APP_URL/auth/instagram/callback.
# Must exactly match a "Valid OAuth Redirect URI" in your Meta app settings.
# INSTAGRAM_REDIRECT_URI=

# Optional. Graph API version.
# INSTAGRAM_API_VERSION=v23.0

# Meta Model API key for AI audience insights (Muse Spark).
# Get one at https://dev.meta.ai → API keys.
MODEL_API_KEY=
# Optional. Defaults to muse-spark-1.3.
# META_MODEL=muse-spark-1.3
